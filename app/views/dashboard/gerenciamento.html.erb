<% if flash[:success] %>
  <div style="background-color: #d4edda; color: #155724; padding: 12px; border: 1px solid #c3e6cb; border-radius: 4px; margin: 20px auto; max-width: 350px; text-align: center; font-family: sans-serif;">
    <%= sanitize(flash[:success]) %>
  </div>
<% end %>

<% if flash[:error] %>
  <div style="background-color: #fef2f2; color: #991b1b; border: 1px solid #fca5a5; border-radius: 8px; padding: 16px; margin: 20px 0; font-family: system-ui, -apple-system, sans-serif; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);">
    <div style="display: flex; align-items: center; margin-bottom: 8px; font-weight: 600; font-size: 1.05rem;">
      <span style="margin-right: 8px; font-size: 1.2rem;">⚠️</span>
      <%= flash[:error] %>
    </div>
  </div>
<% end %>

<% if flash[:notice] %>
  <div style="background-color: #d1ecf1; color: #0c5460; padding: 12px; border: 1px solid #bee5eb; border-radius: 4px; margin: 20px auto; max-width: 350px; text-align: center; font-family: sans-serif;">
    <%= flash[:notice] %>
  </div>
<% end %>

<% content_for :head, stylesheet_link_tag("dashboard", "data-turbo-track": "reload") %>

<div class="dashboard-container">
  <%= render 'layouts/dashboard_shared/sidebar' %>

  <div class="main-content">
    <header class="topbar">
      <button class="hamburger-btn" aria-label="Menu">&#9776;</button>
      <div class="search-container">
        <input type="text" placeholder="Pesquisar..." autocomplete="off">
      </div>

      <details class="user-dropdown">
        <summary class="user-avatar">
          <%= current_user&.nome&.first&.upcase || "U" %>
        </summary>

        <div class="dropdown-menu">
          <div class="dropdown-info">
            <p class="user-name"><strong><%= current_user&.nome %></strong></p>
            <p class="user-detail">Matrícula: <%= current_user&.matricula %></p>
            <p class="user-detail">E-mail: <%= current_user&.email %></p>
          </div>
          <div class="dropdown-divider"></div>

          <%= link_to "Sair da Conta", logout_path, data: { turbo_method: :delete }, class: "logout-btn" %>
        </div>
      </details>
    </header>

    <main class="management-panel">
      <div class="center-card">
        <%= link_to "Importar dados", importar_dados_path, data: { turbo_method: :post }, class: "btn-action btn-primary" %>
        <%= link_to "Enviar Solicitação de Cadastro (E-mail)", enviar_solicitacoes_path, data: { turbo_method: :post }, class: "btn-action btn-secondary" %>

        <%= link_to "Gerenciar Templates", templates_path, class: "btn-action btn-secondary" %>
        <%= link_to "Gerenciar Formulário", formularios_path, class: "btn-action btn-secondary" %>
        <%= link_to "Resultados", "#", class: "btn-action btn-secondary" %>
      </div>
    </main>

  </div>
</div>
