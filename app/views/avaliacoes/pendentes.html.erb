<h1>Avaliações Pendentes</h1>

<% if flash[:notice] %>
  <p id="notice"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p id="alert"><%= flash[:alert] %></p>
<% end %>

<% if @avaliacoes_pendentes.any? %>
  <table>
    <thead>
      <tr>
        <th>Turma</th>
        <th>Status</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% @avaliacoes_pendentes.each do |avaliacao| %>
        <tr>
          <td><%= avaliacao.formulario.turma.nome_exibicao %></td>
          <td><%= avaliacao.nao_respondido? ? "Não respondido" : l(avaliacao.respondido_em, format: :short) %></td>
          <td><%= link_to "Responder", responder_avaliacao_path(avaliacao) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Nenhum formulário pendente foi encontrado.</p>
<% end %>
