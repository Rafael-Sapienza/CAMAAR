<main class="app-page template-page">
  <header class="template-page__header" style="flex-direction: column; align-items: flex-start; gap: 0.5rem;">
    <h1>Criar Formulário</h1>
    <p class="template-show__description">Escolha um template, filtre e selecione as turmas que receberão a avaliação.</p>
  </header>

  <% if flash[:notice] %>
    <div class="app-alert app-alert--success"><%= flash[:notice] %></div>
  <% end %>

  <%= render "form", 
             templates_proprios: @templates_proprios, 
             templates_outros: @templates_outros, 
             materias: @materias, 
             materia_selecionada: @materia_selecionada, 
             somente_semestre_atual: @somente_semestre_atual, # Variável atualizada
             turmas: @turmas %>
</main>