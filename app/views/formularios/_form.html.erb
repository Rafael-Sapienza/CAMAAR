<% # Formulário de Submissão %>
<%= form_with url: formularios_path, class: "template-form" do |form| %>
  <details class="template-form__metadata" open>
    <summary class="template-form__metadata-summary">
      Dados do formulário
    </summary>

    <div class="template-form__metadata-fields">
      
      <% # Seleção de Template %>
      <div class="template-form__field formulario-builder__field">
        <div class="formulario-builder__field-header">
          <div>
            <label>Template base</label>
            <p>Escolha o modelo que será usado para criar os formulários das turmas selecionadas.</p>
          </div>
        </div>

        <% if templates_proprios.empty? && templates_outros.empty? %>
          <p class="app-empty-state">Nenhum template disponível. Crie um template antes de montar um formulário.</p>
        <% else %>
          <div class="formulario-template-picker">
            <% if templates_proprios.any? %>
              <section class="formulario-template-picker__section">
                <div class="formulario-template-picker__section-header">
                  <h3>Meus templates</h3>
                  <span><%= pluralize(templates_proprios.size, "template", "templates") %></span>
                </div>

                <div class="formulario-template-picker__list" role="radiogroup" aria-label="Meus templates">
                <% templates_proprios.each do |template| %>
                    <label class="formulario-template-card">
                      <%= radio_button_tag :template_id,
                                           template.id,
                                           template.id.to_s == template_selecionado.to_s,
                                           required: true,
                                           onchange: "const url = new URL(window.location.href); url.searchParams.set('template_id', this.value); const materia = document.getElementById('materia_id'); if (materia && materia.value) { url.searchParams.set('materia_id', materia.value); } else { url.searchParams.delete('materia_id'); } history.replaceState(null, '', url.toString());" %>
                      <span class="formulario-template-card__body">
                        <strong><%= template.titulo %></strong>
                        <span><%= template.descricao.presence || "Sem descrição cadastrada." %></span>
                        <small>Criado em <%= l(template.criado_em.to_date) %></small>
                      </span>
                    </label>
                <% end %>
                </div>
              </section>
            <% end %>

            <% if templates_outros.any? %>
              <section class="formulario-template-picker__section">
                <div class="formulario-template-picker__section-header">
                  <h3>Templates de outros admins</h3>
                  <span><%= pluralize(templates_outros.size, "template", "templates") %></span>
                </div>

                <div class="formulario-template-picker__list" role="radiogroup" aria-label="Templates de outros admins">
                <% templates_outros.each do |template| %>
                    <label class="formulario-template-card">
                      <%= radio_button_tag :template_id,
                                           template.id,
                                           template.id.to_s == template_selecionado.to_s,
                                           required: true,
                                           onchange: "const url = new URL(window.location.href); url.searchParams.set('template_id', this.value); const materia = document.getElementById('materia_id'); if (materia && materia.value) { url.searchParams.set('materia_id', materia.value); } else { url.searchParams.delete('materia_id'); } history.replaceState(null, '', url.toString());" %>
                      <span class="formulario-template-card__body">
                        <strong><%= template.titulo %></strong>
                        <span><%= template.descricao.presence || "Sem descrição cadastrada." %></span>
                        <small>Por <%= template.adm.nome %> em <%= l(template.criado_em.to_date) %></small>
                      </span>
                    </label>
                <% end %>
                </div>
              </section>
            <% end %>
          </div>
        <% end %>
      </div>

      <% # Filtro de Matéria %>
      <div class="template-form__field formulario-builder__field formulario-builder__field--compact">
        <label for="materia_id">Filtrar por matéria</label>
        <% materia_atual = materias.find { |materia| materia.id.to_s == materia_selecionada.to_s } %>

        <details class="formulario-filter-dropdown">
          <summary id="materia_id">
            <span><%= materia_atual&.nome || "Todas as matérias do departamento" %></span>
          </summary>

          <div class="formulario-filter-dropdown__menu">
            <%= link_to new_formulario_path(template_id: template_selecionado.presence),
              class: ("is-selected" if materia_selecionada.blank?) do %>
              Todas as matérias do departamento
            <% end %>

            <% materias.each do |materia| %>
              <%= link_to new_formulario_path(template_id: template_selecionado.presence, materia_id: materia.id),
                class: ("is-selected" if materia.id.to_s == materia_selecionada.to_s) do %>
                <%= materia.nome %>
              <% end %>
            <% end %>
          </div>
        </details>
      </div>

      <% # Seleção de Público-alvo %>
      <div class="template-form__field formulario-builder__field">
        <label>Público-alvo</label>
        <div class="formulario-choice-grid">
          <% Formulario.publico_alvos.each do |valor, _| %>
            <label class="formulario-choice-card">
              <%= radio_button_tag :publico_alvo, valor, false, id: "publico_alvo_#{valor}", required: true %>
              <span>
                <strong><%= valor == "docentes" ? "Docentes" : "Discentes" %></strong>
                <small><%= valor == "docentes" ? "Avaliação respondida pelos professores." : "Avaliação respondida pelos estudantes." %></small>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <% # Seleção de Turmas %>
      <div class="template-form__field formulario-builder__field">
        <div class="formulario-builder__field-header">
          <div>
            <label>Selecione as turmas alvo</label>
            <p>Apenas turmas vigentes do departamento são exibidas abaixo.</p>
          </div>
          <span class="formulario-builder__badge">Semestre atual</span>
        </div>
        
        <% if turmas.any? %>
          <% turmas.group_by(&:materia).each do |materia, turmas_da_materia| %>
            <fieldset class="template-options formulario-class-group">
              <legend><%= materia.nome %> (<%= materia.codigo %>)</legend>
              
              <div class="formulario-choice-grid formulario-choice-grid--classes">
                <% turmas_da_materia.each do |turma| %>
                  <label class="formulario-choice-card formulario-choice-card--class">
                    <%= check_box_tag "turma_ids[]", turma.id, false, id: "turma_#{turma.id}" %>
                    <span><strong><%= turma.nome_exibicao %></strong></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        <% else %>
          <p class="app-empty-state">Nenhuma turma encontrada no semestre atual para o filtro selecionado.</p>
        <% end %>
      </div>

    </div>
  </details>

  <div class="template-form__actions">
    <%= link_to "Voltar", formularios_path, class: "app-button app-button--secondary" %>
    <%= form.submit "Publicar formulário", class: "app-button" %>
  </div>
<% end %>
