<%= form_with url: formularios_path, class: "template-form" do |form| %>
  <% if flash[:alert] %>
    <div>
      <p><%= flash[:alert] %></p>
    </div>
  <% end %>

  <details class="template-form__metadata" open>
    <summary class="template-form__metadata-summary">
      Dados do formulário
    </summary>

    <div class="template-form__metadata-fields">
      <div class="template-form__field">
        <label for="template_id">Template</label>
        <%= select_tag :template_id,
                       options_from_collection_for_select(templates, :id, :titulo),
                       prompt: "Selecione um template" %>
      </div>

      <div class="template-form__field">
        <p>Turmas</p>
        <% turmas.each do |turma| %>
          <div>
            <label>
              <%= check_box_tag "turma_ids[]", turma.id, false, id: "turma_#{turma.id}" %>
              <%= turma.nome_exibicao %>
            </label>
          </div>
        <% end %>
      </div>

      <div class="template-form__field">
        <p>Público-alvo</p>
        <% Formulario.publico_alvos.each do |valor, _| %>
          <div>
            <label>
              <%= radio_button_tag :publico_alvo, valor, false, id: "publico_alvo_#{valor}" %>
              <%= valor == "docentes" ? "Docentes" : "Discentes" %>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  </details>

  <div class="template-form__actions">
    <%= form.submit "Publicar formulário", class: "template-form__submit" %>
    <%= button_tag "Voltar", onclick: "window.location.href='#{formularios_path}'", class: "template-form__submit", type: :button %>
  </div>
<% end %>
